---
import '../styles/global.css';
import '../styles/app.css';
import { officer } from '../data/mock';

export interface Props {
  title: string;
  active: 'overview' | 'tenders' | 'portals' | 'audit';
  crumbs?: { label: string; href?: string }[];
}

const { title, active, crumbs = [] } = Astro.props;
const base = import.meta.env.BASE_URL;

const nav = [
  {
    group: 'Workspace',
    items: [
      {
        key: 'overview', label: 'Overview', href: `${base}app`,
        icon: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>',
        count: null,
      },
      {
        key: 'tenders', label: 'Tenders', href: `${base}app/tender`,
        icon: '<path d="M4.5 5.5A1.5 1.5 0 0 1 6 4h8l5.5 5.5V19a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 19Z"/><path d="M14 4v5.5h5.5"/><path d="M8.5 13.5h7M8.5 16.5h4.5"/>',
        count: '4',
      },
    ],
  },
  {
    group: 'Compliance',
    items: [
      {
        key: 'portals', label: 'Portal status', href: `${base}app/portals`,
        icon: '<circle cx="12" cy="12" r="3"/><circle cx="12" cy="3.6" r="1.7"/><circle cx="12" cy="20.4" r="1.7"/><circle cx="3.6" cy="12" r="1.7"/><circle cx="20.4" cy="12" r="1.7"/><path d="M12 5.3v3.7M12 15v3.7M5.3 12H9M15 12h3.7"/>',
        count: '1',
        hot: true,
      },
      {
        key: 'audit', label: 'Audit trail', href: `${base}app/audit`,
        icon: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.2V12l3.2 2"/>',
        count: null,
      },
    ],
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#16233D">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2316233D'/%3E%3Cpath d='M16 6 8.5 9.2v5.6c0 4.3 3 7.9 7.5 8.9 4.5-1 7.5-4.6 7.5-8.9V9.2L16 6Z' fill='none' stroke='%23F7F9F5' stroke-width='2' stroke-linejoin='round'/%3E%3Cpath d='m12.6 15.6 2.2 2.4 4.6-4.8' fill='none' stroke='%231B7A5A' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="app">
    <aside class="side" id="side">
      <div class="side-head">
        <a href={base} class="wordmark">
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#F7F9F5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 4 6v6c0 4.6 3.2 8.4 8 9.5 4.8-1.1 8-4.9 8-9.5V6l-8-3.5Z"/><path d="m9 12 2.2 2.4L15.5 10"/></svg>
          </span>
          Pramaan
        </a>
      </div>

      <div class="side-scroll">
        {nav.map((g) => (
          <div class="side-group">
            <h6>{g.group}</h6>
            {g.items.map((it) => (
              <a href={it.href} class={`side-item${active === it.key ? ' on' : ''}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={it.icon}></svg>
                {it.label}
                {it.count && <span class={`count${it.hot ? ' hot' : ''}`}>{it.count}</span>}
              </a>
            ))}
          </div>
        ))}
      </div>

      <div class="side-foot">
        <div class="who-card">
          <span class="av" aria-hidden="true">{officer.initials}</span>
          <span>
            <span class="nm">{officer.name}</span>
            <span class="rl">{officer.role}</span>
          </span>
        </div>
      </div>
    </aside>

    <div class="scrim" id="scrim"></div>

    <div class="main">
      <header class="topbar">
        <button class="icon-btn side-toggle" id="sideToggle" type="button" aria-label="Open navigation" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>

        <nav class="crumb" aria-label="Breadcrumb">
          <a href={`${base}app`}>Console</a>
          {crumbs.map((c) => (
            <>
              <span class="sep" aria-hidden="true">/</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span class="now">{c.label}</span>}
            </>
          ))}
        </nav>

        <div class="top-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
          <input type="search" placeholder="Search bidders, GSTIN, tender ref…" aria-label="Search" />
          <kbd>/</kbd>
        </div>

        <button class="icon-btn" type="button" aria-label="Notifications">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8.5a6 6 0 1 0-12 0c0 5-2 6.5-2 6.5h16s-2-1.5-2-6.5Z"/><path d="M13.7 19a2 2 0 0 1-3.4 0"/></svg>
          <span class="dot" aria-hidden="true"></span>
        </button>
      </header>

      <main class="content">
        <slot />
      </main>
    </div>
  </div>

  <script is:inline>
    (function () {
      var side = document.getElementById('side');
      var scrim = document.getElementById('scrim');
      var btn = document.getElementById('sideToggle');
      if (!side || !scrim || !btn) return;

      function set(open) {
        side.classList.toggle('open', open);
        scrim.classList.toggle('on', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      btn.addEventListener('click', function () { set(!side.classList.contains('open')); });
      scrim.addEventListener('click', function () { set(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
      window.addEventListener('resize', function () { if (window.innerWidth > 960) set(false); });

      // "/" focuses search, the way an operations console should behave
      document.addEventListener('keydown', function (e) {
        if (e.key !== '/' || e.ctrlKey || e.metaKey) return;
        var t = e.target;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA')) return;
        var input = document.querySelector('.top-search input');
        if (input) { e.preventDefault(); input.focus(); }
      });
    })();
  </script>
</body>
</html>
