---
import AppLayout from '../../layouts/AppLayout.astro';
import { portals } from '../../data/mock';

const base = import.meta.env.BASE_URL;

const glyphs: Record<string, string> = {
  gst: '<path d="M8.5 6.5h7M8.5 10h7M14.6 6.5c0 3.5-2.6 3.5-6.1 3.5l7 7.5"/>',
  ban: '<circle cx="12" cy="12" r="8.4"/><path d="m6.6 6.6 10.8 10.8"/>',
};

const degraded = portals.filter((p) => p.status !== 'ok');
---

<AppLayout title="Portal status — Pramaan console" active="portals" crumbs={[{ label: 'Portal status' }]}>
  <div class="page-head">
    <div>
      <h1>Source integrations</h1>
      <div class="meta-row">
        <span><b>11</b> of 12 live</span>
        <span>1,026 calls today</span>
        <span>Median <b>1.1 s</b></span>
        <span>Last sweep 14:11</span>
      </div>
    </div>
    <div class="acts">
      <button class="btn-sm" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11.5A8 8 0 1 1 17.5 6"/><path d="M20 4v5h-5"/></svg>
        Re-test all
      </button>
    </div>
  </div>

  {degraded.length > 0 && (
    <div class="panel" style="margin-bottom:18px; border-color:rgba(180,97,28,.35);">
      <div class="panel-head" style="background:var(--flag-soft); border-bottom-color:rgba(180,97,28,.25);">
        <h2 style="display:flex; align-items:center; gap:9px;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--flag)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5M12 16.2v.1"/><circle cx="12" cy="12" r="9"/></svg>
          {degraded.length} source responding slowly
        </h2>
        <span class="note">Checks are queued, not failed</span>
      </div>
      <div class="panel-body" style="padding:10px 14px;">
        <span style="font-size:13px; color:var(--ink-soft);">
          ESIC latency 6.4 s (normal 1.8 s). <b style="color:var(--ink);">2 checks pending</b> on
          <span class="mono-cell">GEM/2026/B/4471</span> — queued for retry, not failed.
        </span>
      </div>
    </div>
  )}

  <div class="tabs">
    <button class="tab on" type="button">All sources <span class="n">12</span></button>
    <button class="tab" type="button">Live <span class="n">11</span></button>
    <button class="tab" type="button">Degraded <span class="n">1</span></button>
  </div>

  <div class="pgrid">
    {portals.map((p) => (
      <div class="pcard">
        <div class="pcard-h">
          <span class="logo" aria-hidden="true">
            {p.file
              ? <img src={`${base}logos/${p.file}`} alt="" loading="lazy" decoding="async" />
              : <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink-muted)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={glyphs[p.glyph ?? 'ban']}></svg>}
          </span>
          <span class="n">{p.name}</span>
          <span class={`pstat ${p.status}`}>
            <i aria-hidden="true"></i>
            {p.status === 'ok' ? 'Live' : 'Slow'}
          </span>
        </div>
        <div class="pmeta">
          <div>
            <div class="k">Response</div>
            <div class="v" style={p.status !== 'ok' ? 'color:var(--flag)' : ''}>{p.latency}</div>
          </div>
          <div>
            <div class="k">30-day</div>
            <div class="v">{p.uptime}</div>
          </div>
          <div>
            <div class="k">Access</div>
            <div class="v">{p.mode}</div>
          </div>
        </div>
        <div style="margin-top:12px; font-family:var(--mono); font-size:10.5px; color:var(--ink-muted);">
          Last successful call {p.last}
        </div>
      </div>
    ))}
  </div>

</AppLayout>
